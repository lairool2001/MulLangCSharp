// ═══════════════════════════════════════════════════════════
//  乒乓球 GUI 版 — WinForms 表單 + 計時器（Timer）+ GDI+ 繪圖
//  以「自然對人工語言轉換」撰寫；WinForms／GDI+ 的名稱來自 ctdll 轉換表
//  執行：在中文 C# 編輯器開啟本檔，按 Ctrl+F5
//  操作：左方 W／S　右方 ↑／↓（按下後改由玩家二控制，否則是電腦）
//        P 暫停　空白鍵 重新開始　Esc 離開　先得 7 分者獲勝
// ═══════════════════════════════════════════════════════════
使用 系統;
使用 系統的繪圖;
使用 系統的繪圖的繪圖2D;
使用 系統的視窗群的表單群;

命名空間 乒乓遊戲GUI
{
    類別 乒乓表單 : 表單
    {
        // ── 場地與物件尺寸（像素） ──
        常數 整數 場寬 被指派 800;
        常數 整數 場高 被指派 500;
        常數 浮點數 拍寬 被指派 14f;
        常數 浮點數 拍長 被指派 90f;
        常數 浮點數 拍邊距 被指派 30f;
        常數 浮點數 拍速 被指派 7f;
        常數 浮點數 球半徑 被指派 9f;
        常數 浮點數 起始球速 被指派 6f;
        常數 整數 勝利分數 被指派 7;

        // ── 遊戲狀態 ──
        私有 浮點數 左拍Y, 右拍Y;
        私有 浮點數 球X, 球Y, 球速X, 球速Y;
        私有 整數 左分, 右分;
        私有 布林 左上, 左下, 右上, 右下;
        私有 布林 電腦對手 被指派 真;
        私有 布林 暫停中;
        私有 字串 中央訊息 被指派 "按空白鍵開始";
        私有 布林 等待開始 被指派 真;

        私有 唯讀 計時器 遊戲計時器 被指派 新 計時器();
        私有 唯讀 隨機 亂數 被指派 新 隨機();
        私有 唯讀 字型 比分字型 被指派 新 字型("Microsoft JhengHei UI", 36, 字型風格的粗體);
        私有 唯讀 字型 訊息字型 被指派 新 字型("Microsoft JhengHei UI", 18);

        公開 乒乓表單()
        {
            這個的文字 被指派 "乒乓球（WinForms + GDI+）";
            這個的用戶端大小 被指派 新 大小(場寬, 場高);
            這個的表單框線風格 被指派 表單框線風格的固定單一;
            這個的最大化方塊 被指派 假;
            這個的啟動位置 被指派 表單啟動位置的中心螢幕;
            這個的背景色 被指派 色彩的黑色;
            這個的雙重緩衝 被指派 真;    // 避免閃爍
            這個的鍵預覽 被指派 真;

            重置位置();

            遊戲計時器的間隔 被指派 16;     // 約每秒 60 格
            遊戲計時器的刻度 加上 遊戲迴圈;
            遊戲計時器的啟動();
        }

        // ── 遊戲迴圈（計時器每次觸發） ──

        私有 虛無 遊戲迴圈(物件 傳送者, 事件引數群 e)
        {
            如果 (非 暫停中 而且 非 等待開始)
            {
                移動球拍();
                移動球();
            }
            重新繪製();     // 要求重畫 → 觸發 於塗繪
        }

        私有 虛無 重置位置()
        {
            左拍Y 被指派 (場高 - 拍長) / 2;
            右拍Y 被指派 (場高 - 拍長) / 2;
            發球(亂數的下一個(2) 等於 0 ? -1 : 1);
        }

        私有 虛無 發球(整數 方向)
        {
            球X 被指派 場寬 / 2f;
            球Y 被指派 場高 / 2f;
            浮點數 角度 被指派 (浮點數)(亂數的下一個雙精度() * 0.8 - 0.4);   // 約 ±23 度
            球速X 被指派 方向 * 起始球速 * (浮點數)數學的餘弦(角度);
            球速Y 被指派 起始球速 * (浮點數)數學的正弦(角度);
        }

        私有 虛無 移動球拍()
        {
            如果 (左上) 左拍Y 減掉 拍速;
            如果 (左下) 左拍Y 加上 拍速;

            如果 (電腦對手)
            {
                // 電腦：球往右飛時追著球的高度跑，速度略慢於玩家
                浮點數 目標 被指派 球速X 大於 0 ? 球Y - 拍長 / 2 : (場高 - 拍長) / 2;
                浮點數 差距 被指派 目標 - 右拍Y;
                右拍Y 加上 數學的限制範圍(差距, -拍速 * 0.8f, 拍速 * 0.8f);
            }
            否則
            {
                如果 (右上) 右拍Y 減掉 拍速;
                如果 (右下) 右拍Y 加上 拍速;
            }

            左拍Y 被指派 數學的限制範圍(左拍Y, 0, 場高 - 拍長);
            右拍Y 被指派 數學的限制範圍(右拍Y, 0, 場高 - 拍長);
        }

        私有 虛無 移動球()
        {
            球X 加上 球速X;
            球Y 加上 球速Y;

            // 上下牆反彈
            如果 (球Y - 球半徑 小於 0 或是 球Y + 球半徑 大於 場高)
            {
                球速Y 被指派 -球速Y;
                球Y 被指派 數學的限制範圍(球Y, 球半徑, 場高 - 球半徑);
            }

            // 球拍反彈（擊中位置越靠邊緣，反彈角度越大；每次擊球加速 5%）
            浮點數 左拍右緣 被指派 拍邊距 + 拍寬;
            浮點數 右拍左緣 被指派 場寬 - 拍邊距 - 拍寬;
            如果 (球速X 小於 0 而且 球X - 球半徑 小於等於 左拍右緣 而且 球X 大於 拍邊距 而且 打到(左拍Y))
            {
                反彈(左拍Y, 1);
                球X 被指派 左拍右緣 + 球半徑;
            }
            否則 如果 (球速X 大於 0 而且 球X + 球半徑 大於等於 右拍左緣 而且 球X 小於 場寬 - 拍邊距 而且 打到(右拍Y))
            {
                反彈(右拍Y, -1);
                球X 被指派 右拍左緣 - 球半徑;
            }

            // 出界得分
            如果 (球X 小於 0) 得分(假);
            否則 如果 (球X 大於 場寬) 得分(真);
        }

        私有 布林 打到(浮點數 拍Y) => 球Y + 球半徑 大於等於 拍Y 而且 球Y - 球半徑 小於等於 拍Y + 拍長;

        私有 虛無 反彈(浮點數 拍Y, 整數 方向)
        {
            浮點數 偏移 被指派 (球Y - (拍Y + 拍長 / 2)) / (拍長 / 2);   // -1（上緣）～ 1（下緣）
            浮點數 速度 被指派 (浮點數)數學的平方根(球速X * 球速X + 球速Y * 球速Y) * 1.05f;
            浮點數 角度 被指派 偏移 * 1.0f;                               // 最大約 57 度
            球速X 被指派 方向 * 速度 * (浮點數)數學的餘弦(角度);
            球速Y 被指派 速度 * (浮點數)數學的正弦(角度);
        }

        私有 虛無 得分(布林 左方得分)
        {
            如果 (左方得分) 左分加一; 否則 右分加一;

            如果 (左分 大於等於 勝利分數 或是 右分 大於等於 勝利分數)
            {
                中央訊息 被指派 $"{(左分 大於 右分 ? "玩家一" : 右方名稱())} 獲勝！按空白鍵再玩一局";
                等待開始 被指派 真;
                重置位置();
                回傳;
            }
            發球(左方得分 ? 1 : -1);
        }

        私有 字串 右方名稱() => 電腦對手 ? "電腦" : "玩家二";

        // ── GDI+ 繪圖 ──

        保護 覆寫 虛無 於塗繪(塗繪事件引數群 e)
        {
            基底的於塗繪(e);
            圖形 g 被指派 e的圖形;
            g的平滑模式 被指派 平滑模式的反鋸齒;

            // 中線（虛線）
            使用 (變數 中線筆 被指派 新 畫筆(色彩的灰色, 4))
            {
                中線筆的虛線風格 被指派 虛線風格的虛線;
                g的繪製線條(中線筆, 場寬 / 2, 0, 場寬 / 2, 場高);
            }

            // 比分
            畫置中文字(g, 左分的轉字串(), 比分字型, 場寬 / 4f, 20);
            畫置中文字(g, 右分的轉字串(), 比分字型, 場寬 * 3 / 4f, 20);

            // 球拍與球
            g的填入矩形(筆刷集的白色, 拍邊距, 左拍Y, 拍寬, 拍長);
            g的填入矩形(筆刷集的白色, 場寬 - 拍邊距 - 拍寬, 右拍Y, 拍寬, 拍長);
            g的填入橢圓(筆刷集的黃色, 球X - 球半徑, 球Y - 球半徑, 球半徑 * 2, 球半徑 * 2);

            // 訊息與說明
            如果 (等待開始) 畫置中文字(g, 中央訊息, 訊息字型, 場寬 / 2f, 場高 / 2f + 40);
            否則 如果 (暫停中) 畫置中文字(g, "暫停中，按 P 繼續", 訊息字型, 場寬 / 2f, 場高 / 2f + 40);
            畫置中文字(g, $"玩家一：W／S　　{右方名稱()}：↑／↓　　P 暫停　Esc 離開", 訊息字型, 場寬 / 2f, 場高 - 36);
        }

        私有 虛無 畫置中文字(圖形 g, 字串 文字內容, 字型 字型樣式, 浮點數 中心X, 浮點數 上緣)
        {
            變數 尺寸 被指派 g的測量字串(文字內容, 字型樣式);
            g的繪製字串(文字內容, 字型樣式, 筆刷集的白色, 中心X - 尺寸的寬度 / 2, 上緣);
        }

        // ── 鍵盤 ──

        保護 覆寫 布林 是否輸入鍵(鍵群 按鍵資料) => 按鍵資料 等於 鍵群的上 或是 按鍵資料 等於 鍵群的下 或是 基底的是否輸入鍵(按鍵資料);

        保護 覆寫 虛無 於鍵下(鍵事件引數群 e)
        {
            切換 (e的鍵程式碼)
            {
                情況 鍵群的W鍵: 左上 被指派 真; 中斷;
                情況 鍵群的S鍵: 左下 被指派 真; 中斷;
                情況 鍵群的上: 右上 被指派 真; 電腦對手 被指派 假; 中斷;
                情況 鍵群的下: 右下 被指派 真; 電腦對手 被指派 假; 中斷;
                情況 鍵群的P鍵:
                    如果 (非 等待開始) 暫停中 被指派 非 暫停中;
                    中斷;
                情況 鍵群的空格:
                    如果 (左分 大於等於 勝利分數 或是 右分 大於等於 勝利分數)
                    {
                        左分 被指派 0;
                        右分 被指派 0;
                    }
                    等待開始 被指派 假;
                    暫停中 被指派 假;
                    中斷;
                情況 鍵群的跳脫鍵:
                    這個的關閉();
                    中斷;
            }
            e的已處理 被指派 真;
        }

        保護 覆寫 虛無 於鍵上(鍵事件引數群 e)
        {
            切換 (e的鍵程式碼)
            {
                情況 鍵群的W鍵: 左上 被指派 假; 中斷;
                情況 鍵群的S鍵: 左下 被指派 假; 中斷;
                情況 鍵群的上: 右上 被指派 假; 中斷;
                情況 鍵群的下: 右下 被指派 假; 中斷;
            }
        }

        保護 覆寫 虛無 處置(布林 處置中)
        {
            如果 (處置中)
            {
                遊戲計時器的處置();
                比分字型的處置();
                訊息字型的處置();
            }
            基底的處置(處置中);
        }

        // ── 進入點 ──

        [單執行緒套間]
        靜態 虛無 主程式()
        {
            應用程式的設定高解析度模式(高解析度模式的系統感知);
            應用程式的啟用視覺樣式群();
            應用程式的執行(新 乒乓表單());
        }
    }
}
