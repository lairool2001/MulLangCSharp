// ═══════════════════════════════════════════════════════════
//  乒乓球（PingPong）— 以「自然對人工語言轉換」撰寫的中文 C#
//  執行：在中文 C# 編輯器開啟本檔，按 Ctrl+F5（啟動但不偵錯）
//  操作：左方 W／S　右方 ↑／↓（按下後改由玩家二控制，否則是電腦）
//        P 暫停　Esc 離開　先得 5 分者獲勝
// ═══════════════════════════════════════════════════════════
使用 系統;
使用 系統的文字;
使用 系統的執行緒;

命名空間 乒乓遊戲
{
    類別 程式
    {
        // ── 場地設定 ──
        常數 整數 寬 被指派 60;
        常數 整數 高 被指派 20;
        常數 整數 球拍長 被指派 4;
        常數 整數 左拍X 被指派 2;
        常數 整數 右拍X 被指派 寬 - 3;
        常數 整數 勝利分數 被指派 5;
        常數 整數 每格毫秒 被指派 30;

        // ── 遊戲狀態 ──
        靜態 整數 左拍Y;
        靜態 整數 右拍Y;
        靜態 整數 球X;
        靜態 整數 球Y;
        靜態 整數 球速X;
        靜態 整數 球速Y;
        靜態 整數 左分;
        靜態 整數 右分;
        靜態 布林 電腦對手 被指派 真;
        靜態 唯讀 隨機 亂數 被指派 新 隨機();

        靜態 虛無 主程式()
        {
            主控台的標題 被指派 "乒乓球";
            主控台的游標可見 被指派 假;
            主控台的清除();

            重置球拍();
            發球(亂數的下一個(2) 等於 0 ? 1 : -1);

            布林 暫停中 被指派 假;
            整數 影格 被指派 0;

            當 (真)
            {
                // ── 處理按鍵 ──
                當 (主控台的有按鍵)
                {
                    切換 (主控台的讀鍵(真)的鍵)
                    {
                        情況 主控台按鍵的W鍵:
                            移動球拍(參考 左拍Y, -1);
                            中斷;
                        情況 主控台按鍵的S鍵:
                            移動球拍(參考 左拍Y, 1);
                            中斷;
                        情況 主控台按鍵的上箭頭:
                            電腦對手 被指派 假;
                            移動球拍(參考 右拍Y, -1);
                            中斷;
                        情況 主控台按鍵的下箭頭:
                            電腦對手 被指派 假;
                            移動球拍(參考 右拍Y, 1);
                            中斷;
                        情況 主控台按鍵的P鍵:
                            暫停中 被指派 非 暫停中;
                            中斷;
                        情況 主控台按鍵的跳脫鍵:
                            結束遊戲();
                            回傳;
                    }
                }

                // ── 更新 ──
                如果 (非 暫停中)
                {
                    如果 (電腦對手 而且 影格 % 2 等於 0)
                        電腦移動();

                    如果 (影格 % 2 等於 0)
                    {
                        整數 得分方 被指派 移動球();
                        如果 (得分方 不等於 0)
                        {
                            如果 (得分方 小於 0) 左分加一; 否則 右分加一;
                            繪製(假);
                            顯示訊息(得分方 小於 0 ? "玩家一得分！" : $"{右方名稱()}得分！");
                            執行緒物件的睡眠(800);

                            如果 (左分 大於等於 勝利分數 或是 右分 大於等於 勝利分數)
                            {
                                如果 (非 再玩一局())
                                {
                                    結束遊戲();
                                    回傳;
                                }
                            }
                            重置球拍();
                            發球(得分方);
                            主控台的清除();
                        }
                    }
                }

                繪製(暫停中);
                影格加一;
                執行緒物件的睡眠(每格毫秒);
            }
        }

        // ── 球與球拍 ──

        靜態 虛無 重置球拍()
        {
            左拍Y 被指派 (高 - 球拍長) / 2;
            右拍Y 被指派 (高 - 球拍長) / 2;
        }

        /// 從場地中央發球，方向：負數往左、正數往右。
        靜態 虛無 發球(整數 方向)
        {
            球X 被指派 寬 / 2;
            球Y 被指派 亂數的下一個(高 / 4, 高 * 3 / 4);
            球速X 被指派 方向 小於 0 ? -1 : 1;
            球速Y 被指派 亂數的下一個(2) 等於 0 ? -1 : 1;
        }

        靜態 虛無 移動球拍(參考 整數 y, 整數 方向)
        {
            y 加上 方向;
            y 被指派 數學的限制範圍(y, 1, 高 - 1 - 球拍長);
        }

        靜態 布林 打到球拍(整數 拍Y, 整數 y) => y 大於等於 拍Y 而且 y 小於 拍Y + 球拍長;

        /// 依擊中球拍的位置決定反彈角度：上半部往上、下半部往下、正中央隨機。
        靜態 整數 反彈角度(整數 拍Y, 整數 y)
        {
            整數 偏移 被指派 y - (拍Y + 球拍長 / 2);
            如果 (偏移 小於 0) 回傳 -1;
            如果 (偏移 大於 0) 回傳 1;
            回傳 亂數的下一個(2) 等於 0 ? -1 : 1;
        }

        /// 移動球一格；有人得分時傳回 -1（玩家一得分）或 1（右方得分），否則傳回 0。
        靜態 整數 移動球()
        {
            整數 下一X 被指派 球X + 球速X;
            整數 下一Y 被指派 球Y + 球速Y;

            // 上下牆反彈
            如果 (下一Y 小於 1 或是 下一Y 大於 高 - 2)
            {
                球速Y 被指派 -球速Y;
                下一Y 被指派 球Y + 球速Y;
            }

            // 球拍反彈
            如果 (球速X 小於 0 而且 下一X 等於 左拍X 而且 打到球拍(左拍Y, 下一Y))
            {
                球速X 被指派 1;
                球速Y 被指派 反彈角度(左拍Y, 下一Y);
                下一X 被指派 球X + 球速X;
                主控台的寫("\a");
            }
            否則 如果 (球速X 大於 0 而且 下一X 等於 右拍X 而且 打到球拍(右拍Y, 下一Y))
            {
                球速X 被指派 -1;
                球速Y 被指派 反彈角度(右拍Y, 下一Y);
                下一X 被指派 球X + 球速X;
                主控台的寫("\a");
            }

            球X 被指派 下一X;
            球Y 被指派 數學的限制範圍(下一Y, 1, 高 - 2);

            如果 (球X 小於等於 0) 回傳 1;
            如果 (球X 大於等於 寬 - 1) 回傳 -1;
            回傳 0;
        }

        /// 電腦控制右拍：球往右飛時追著球跑，偶爾反應慢一拍。
        靜態 虛無 電腦移動()
        {
            如果 (球速X 小於 0 或是 亂數的下一個(100) 大於等於 85) 回傳;
            整數 中心 被指派 右拍Y + 球拍長 / 2;
            如果 (球Y 小於 中心) 移動球拍(參考 右拍Y, -1);
            否則 如果 (球Y 大於 中心) 移動球拍(參考 右拍Y, 1);
        }

        // ── 畫面 ──

        靜態 字串 右方名稱() => 電腦對手 ? "電腦" : "玩家二";

        /// 先把整個畫面組成一個字串再一次輸出，避免閃爍。
        靜態 虛無 繪製(布林 暫停中)
        {
            變數 畫面 被指派 新 字串建構器();
            對於 (整數 y 被指派 0; y 小於 高; y加一)
            {
                對於 (整數 x 被指派 0; x 小於 寬; x加一)
                {
                    字元 c 被指派 ' ';
                    如果 (y 等於 0 或是 y 等於 高 - 1) c 被指派 '=';
                    否則 如果 (x 等於 寬 / 2 而且 y % 2 等於 0) c 被指派 ':';

                    如果 (x 等於 左拍X 而且 打到球拍(左拍Y, y)) c 被指派 '#';
                    如果 (x 等於 右拍X 而且 打到球拍(右拍Y, y)) c 被指派 '#';
                    如果 (x 等於 球X 而且 y 等於 球Y) c 被指派 'O';
                    畫面的附加(c);
                }
                畫面的附加行();
            }
            畫面的附加行($"  玩家一 {左分}  :  {右分} {右方名稱()}        ");
            畫面的附加行(暫停中
                ? "  ── 暫停中，按 P 繼續 ──                          "
                : "  W/S 與 ↑/↓ 移動球拍，P 暫停，Esc 離開           ");

            主控台的設定游標位置(0, 0);
            主控台的寫(畫面);
        }

        靜態 虛無 顯示訊息(字串 訊息)
        {
            主控台的設定游標位置(寬 / 2 - 訊息的長度, 高 / 2);
            主控台的前景色彩 被指派 主控台色彩的黃色;
            主控台的寫(訊息);
            主控台的重設色彩();
        }

        /// 有人獲勝時詢問是否再玩一局。
        靜態 布林 再玩一局()
        {
            字串 勝者 被指派 左分 大於 右分 ? "玩家一" : 右方名稱();
            顯示訊息($" {勝者}獲勝！ ");
            主控台的設定游標位置(寬 / 2 - 13, 高 / 2 + 2);
            主控台的寫("按 Y 再玩一局，其他鍵離開");

            當 (主控台的有按鍵) 主控台的讀鍵(真);
            如果 (主控台的讀鍵(真)的鍵 不等於 主控台按鍵的Y鍵) 回傳 假;

            左分 被指派 0;
            右分 被指派 0;
            回傳 真;
        }

        靜態 虛無 結束遊戲()
        {
            主控台的游標可見 被指派 真;
            主控台的設定游標位置(0, 高 + 3);
            主控台的寫行($"最終比分　玩家一 {左分} : {右分} {右方名稱()}　　謝謝遊玩！");
        }
    }
}
